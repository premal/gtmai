load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "config",
    srcs = [
        "package.json",
        "tsconfig.json",
        "tsconfig.seed.json",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["src/**"]),
)

# Prisma schema + migrations + seed: a change invalidates every
# database-dependent test.
filegroup(
    name = "prisma",
    srcs = glob(["prisma/**"]),
)

# Workspace-linked package contents — see packages/shared:pkg.
js_library(
    name = "pkg",
    srcs = [":srcs", ":prisma", "package.json"],
)

eslint_bin.eslint_test(
    name = "lint",
    args = ["src"],
    chdir = "packages/db",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:node_modules",
        "//:workspace_config_js",
    ],
    size = "medium",
)

# db typecheck/build compile src/index.ts, which re-exports @prisma/client —
# types come from the generated client in node_modules/.prisma, which Bazel
# can't populate. Run in the source tree via the dbgen wrapper (regenerates
# the client first; still part of the rdeps graph).

_LOCAL = ["local", "no-sandbox", "requires-network"]

sh_test(
    name = "typecheck",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/db", "typecheck"],
    data = [":config", ":prisma", ":srcs", "//:workspace_config"],
    tags = _LOCAL,
    size = "medium",
)

# seed.ts lives outside src/ and has its own tsconfig.
sh_test(
    name = "typecheck_seed",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/db", "typecheck:seed"],
    data = [":config", ":prisma", ":srcs", "//:workspace_config"],
    tags = _LOCAL,
    size = "medium",
)

sh_test(
    name = "build",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/db", "build"],
    data = [":config", ":prisma", ":srcs", "//:workspace_config"],
    tags = _LOCAL,
    size = "medium",
)
