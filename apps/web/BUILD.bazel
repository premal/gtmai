load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "config",
    srcs = [
        "next-env.d.ts",
        "next.config.ts",
        "package.json",
        "tailwind.config.ts",
        "tsconfig.check.json",
        "tsconfig.json",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["app/**"]),
)

# eslint flat config lives at the workspace root and imports
# @typescript-eslint/parser from the root node_modules link.
eslint_bin.eslint_test(
    name = "lint",
    args = ["app", "--no-warn-ignored"],
    chdir = "apps/web",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:node_modules",
        "//:workspace_config_js",
    ],
    size = "medium",
)

# web has no unit tests — just typecheck and a real `next build`, both in the
# source tree (next build writes .next and fetches SWC deps).
_LOCAL = ["local", "no-sandbox", "requires-network"]

# typecheck resolves @gtmai/shared via tsconfig.check.json paths (sources,
# no dist needed). build uses the ... filter suffix to compile shared's dist
# first, matching apps/web/Dockerfile.
sh_test(
    name = "typecheck",
    srcs = ["//tools/bazel:pnpm.sh"],
    args = ["--filter", "@gtmai/web", "typecheck"],
    data = [":config", ":srcs", "//:workspace_config", "//packages/shared:srcs"],
    tags = _LOCAL,
    size = "medium",
)

sh_test(
    name = "build",
    srcs = ["//tools/bazel:pnpm.sh"],
    args = ["--filter", "@gtmai/web...", "build"],
    data = [":config", ":srcs", "//:workspace_config", "//packages/shared:srcs"],
    tags = _LOCAL,
    size = "large",
    timeout = "long",
)
