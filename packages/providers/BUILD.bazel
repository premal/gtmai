load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/providers:vitest/package_json.bzl", vitest_bin = "bin")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "config",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["src/**"],
        exclude = ["src/**/*.test.ts"],
    ),
)

# Workspace-linked package contents — see packages/shared:pkg.
js_library(
    name = "pkg",
    srcs = [":srcs", "package.json"],
)

# ---------------------------------------------------------------------------
# Hermetic targets (Bazel-managed node + node_modules from the lockfile)
# ---------------------------------------------------------------------------

vitest_bin.vitest_test(
    name = "unit_llm",
    args = ["run", "src/llm.test.ts"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        "//:workspace_config_js",
        "src/llm.test.ts",
        "src/llm.ts",
        "src/types.ts",
    ],
    size = "small",
)

vitest_bin.vitest_test(
    name = "unit_tavily",
    args = ["run", "src/tavily.test.ts"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        "//:workspace_config_js",
        "src/tavily.test.ts",
        "src/tavily.ts",
        "src/types.ts",
    ],
    size = "small",
)

# providers.test.ts imports ./index, which re-exports every adapter.
vitest_bin.vitest_test(
    name = "unit_providers",
    args = ["run", "src/providers.test.ts"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:workspace_config_js",
        "src/providers.test.ts",
    ],
    size = "small",
)

vitest_bin.vitest_test(
    name = "unit_hginsights",
    args = ["run", "src/hginsights.test.ts"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:workspace_config_js",
        "src/hginsights.test.ts",
    ],
    size = "small",
)

vitest_bin.vitest_test(
    name = "unit_theirstack",
    args = ["run", "src/theirstack.test.ts"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:workspace_config_js",
        "src/theirstack.test.ts",
    ],
    size = "small",
)

eslint_bin.eslint_test(
    name = "lint",
    args = ["src", "--no-warn-ignored"],
    chdir = "packages/providers",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:node_modules",
        "//:workspace_config_js",
    ],
    size = "medium",
)

# ---------------------------------------------------------------------------
# Non-hermetic wrappers
# ---------------------------------------------------------------------------

_LOCAL = ["local", "no-sandbox", "requires-network"]

sh_test(
    name = "typecheck",
    srcs = ["//tools/bazel:pnpm.sh"],
    args = ["--filter", "@gtmai/providers", "typecheck"],
    data = [":config", ":srcs", "//:workspace_config"],
    tags = _LOCAL,
    size = "medium",
)

sh_test(
    name = "build",
    srcs = ["//tools/bazel:pnpm.sh"],
    args = ["--filter", "@gtmai/providers", "build"],
    data = [":config", ":srcs", "//:workspace_config"],
    tags = _LOCAL,
    size = "medium",
)
