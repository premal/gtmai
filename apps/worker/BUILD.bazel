load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "config",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["src/**"],
        exclude = ["src/**/*.test.ts"],
    ),
)

# The worker imports @gtmai/db (PrismaClient), @gtmai/providers and
# @gtmai/shared — every test/typecheck/build target needs those sources plus
# the generated Prisma client (dbgen wrapper), so they run locally.
_DEPS = [
    ":config",
    ":srcs",
    "//:workspace_config",
    "//packages/db:config",
    "//packages/db:prisma",
    "//packages/db:srcs",
    "//packages/providers:srcs",
    "//packages/shared:srcs",
]

# eslint flat config lives at the workspace root and imports
# @typescript-eslint/parser from the root node_modules link.
eslint_bin.eslint_test(
    name = "lint",
    args = ["src", "--no-warn-ignored"],
    chdir = "apps/worker",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:node_modules",
        "//:workspace_config_js",
    ],
    size = "medium",
)

_LOCAL = ["local", "no-sandbox", "requires-network"]

# One target per test file so bazel-affected.sh maps a changed test file to
# exactly its test. They import modules that construct PrismaClient, so they
# need the generated client (dbgen wrapper) but no live services — ioredis
# retries in the background and NODE_ENV=test keeps the workers from running.
[
    sh_test(
        name = "unit_%s" % name,
        srcs = ["//tools/bazel:dbgen.sh"],
        args = ["--filter", "@gtmai/worker", "test", "src/%s.test.ts" % name],
        data = _DEPS + ["src/%s.test.ts" % name],
        tags = _LOCAL,
        size = "medium",
    )
    for name in [
        "main",
        "executors",
        "ads",
        "budgets",
        "crm",
        "outbound",
        "signal-targets",
    ]
]

sh_test(
    name = "typecheck",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/worker", "typecheck"],
    data = _DEPS,
    tags = _LOCAL,
    size = "medium",
)

sh_test(
    name = "build",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/worker", "build"],
    data = _DEPS,
    tags = _LOCAL,
    size = "medium",
)
