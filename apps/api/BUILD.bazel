load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "config",
    srcs = [
        "package.json",
        "tsconfig.json",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(
        ["src/**"],
        exclude = ["src/**/*.test.ts"],
    ),
)

# Everything the Nest app touches transitively: its own sources plus the
# workspace packages it imports and the Prisma schema it migrates/queries.
_DEPS = [
    ":config",
    ":srcs",
    "//:workspace_config",
    "//packages/db:config",
    "//packages/db:prisma",
    "//packages/db:srcs",
    "//packages/providers:srcs",
    "//packages/shared:srcs",
]

# eslint flat config lives at the workspace root and imports
# @typescript-eslint/parser from the root node_modules link.
eslint_bin.eslint_test(
    name = "lint",
    args = ["src", "--no-warn-ignored"],
    chdir = "apps/api",
    data = [
        ":config",
        ":node_modules",
        ":srcs",
        "//:node_modules",
        "//:workspace_config_js",
    ],
    size = "medium",
)

# typecheck/build need the generated Prisma client (node_modules/.prisma),
# which Bazel can't inject into a sandbox — run via the dbgen wrapper in the
# real source tree.
_LOCAL = ["local", "no-sandbox", "requires-network"]

sh_test(
    name = "typecheck",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/api", "typecheck"],
    data = _DEPS,
    tags = _LOCAL,
    size = "medium",
)

sh_test(
    name = "build",
    srcs = ["//tools/bazel:dbgen.sh"],
    args = ["--filter", "@gtmai/api", "build"],
    data = _DEPS,
    tags = _LOCAL,
    size = "large",
)

# Integration tests: every test file that boots the Nest app needs real
# Postgres + Redis — itest.sh starts ephemeral containers per target and
# applies migrations before running vitest on just that file. One target per
# file keeps bazel-affected.sh precise: editing a test reruns only that test.
[
    sh_test(
        name = "itest_%s" % path.replace("/", "_"),
        srcs = ["//tools/bazel:itest.sh"],
        args = ["@gtmai/api", "src/%s.test.ts" % path],
        data = _DEPS + ["src/%s.test.ts" % path],
        tags = _LOCAL + ["itest"],
        size = "large",
        timeout = "long",
    )
    for path in [
        "main",
        "metaprompt",
        "search/search",
        "tables/fanout",
        "tables/views",
    ]
]

# `bazel test //apps/api:itest` still runs the whole integration suite.
test_suite(
    name = "itest",
    tests = [
        ":itest_main",
        ":itest_metaprompt",
        ":itest_search_search",
        ":itest_tables_fanout",
        ":itest_tables_views",
    ],
)

# Pure unit tests need workspace dist/ + the generated Prisma client (dbgen
# wrapper) but no live services.
[
    sh_test(
        name = "unit_%s" % path.replace("/", "_"),
        srcs = ["//tools/bazel:dbgen.sh"],
        args = ["--filter", "@gtmai/api", "test", "src/%s.test.ts" % path],
        data = _DEPS + ["src/%s.test.ts" % path],
        tags = _LOCAL,
        size = "medium",
    )
    for path in [
        "audiences/audiences",
        "functions/functions",
        "tables/view-helper",
    ]
]
