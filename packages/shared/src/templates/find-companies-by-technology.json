      { "name": "Country", "kind": "input", "type": "text", "config": {} },
      {
        "name": "Tech stack",
        "kind": "enrichment",
        "type": "json",
        "config": {
          "provider": "theirstack",
          "action": "theirstack.companyTechnologies",
          "input": { "domain": "{{Domain}}" }
        }
      }
    ]
  }
}
